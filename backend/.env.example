# ─── Servidor ────────────────────────────────────────────────────
PORT=3001

# ─── Base de datos ───────────────────────────────────────────────
# Local:   mongodb://localhost:27017/mercapp
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mercapp?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mercapp

# ─── CORS ────────────────────────────────────────────────────────
